# ============================================================
# Portfolio Intelligence Tool — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# Usage: The app reads these via python-dotenv.
# Run: cp .env.example .env
# ============================================================

# ------------------------------------------------------------
# LLM Configuration
# Choose ONE provider. Leave others blank.
# ------------------------------------------------------------

# Anthropic Claude (recommended for quality)
# Get key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Google Gemini
# Get key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# Ollama (local, no key needed — just run Ollama locally)
# Install: https://ollama.ai
# Pull model: ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------------------------
# News & Sentiment
# ------------------------------------------------------------

# Finnhub — free tier, 60 req/min
# Sign up at: https://finnhub.io (no credit card required)
FINNHUB_API_KEY=

# Reddit API — for WSB + r/investing sentiment
# Create app at: https://www.reddit.com/prefs/apps
# Type: "script"
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=PortfolioIntelligence/1.0

# ------------------------------------------------------------
# Optional: SEC EDGAR (no key needed, just your contact info
# for the User-Agent header as required by SEC)
# ------------------------------------------------------------
EDGAR_USER_AGENT=YourName your@email.com
